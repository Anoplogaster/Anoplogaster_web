size = 4.5, fontface = "bold", family = "exo2") +
# STUDY SECTION
geom_rect(data = div_long, aes(xmin = Min, xmax = Max, ymin = y_pos - 0.18, ymax = y_pos + 0.18, fill = Order),
alpha = 0.75, color = "white", size = 0.3) +
geom_segment(data = div_long, aes(x = Mean, xend = Mean, y = y_pos - 0.18, yend = y_pos + 0.18),
color = "black", size = 1.1) +
# LABELS
annotate("text", x = 153, y = 10.25, label = "BERYCIFORM FOSSILS", angle = 90,
size = 2.8, fontface = "bold", color = "#00CED1", family = "exo2") +
annotate("text", x = 153, y = 7.5, label = "TRACHICHTHYIFORM FOSSILS", angle = 90,
size = 2.8, fontface = "bold", color = "#FF3030", family = "exo2") +
scale_x_reverse(limits = c(155, 0), breaks = seq(0, 150, 25), expand = c(0,0)) +
scale_y_continuous(breaks = 1:5, labels = rev(divergence_data$Study), limits = c(-0.5, 12.5)) +
scale_fill_manual(values = c("Beryciformes" = "#00F5FF", "Trachichthyiformes" = "#FF3030")) +
scale_color_manual(values = c("Beryciformes" = "#00CED1", "Trachichthyiformes" = "#CD2626")) +
labs(x = "Millions of Years Ago (Ma)", y = NULL) +
theme_minimal(base_size = 14, base_family = "exo2") +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.major.x = element_line(color = "grey97"),
axis.title.x = element_text(margin = margin(t = 15), face = "bold", color = "grey20"),
axis.text.y = element_text(face = "bold", size = 10.5, color = "black"),
axis.text.x = element_text(face = "bold", color = "grey30"),
legend.position = "none"
)
library(ggplot2)
library(dplyr)
library(tidyr)
# ---------------------------
# 1. Study Data
# ---------------------------
divergence_data <- data.frame(
Study = c("Near et al. (2012)", "Alfaro et al. (2018)",
"Ghezelayagh et al. (2022)", "Andrews et al. (2023)",
"Brownstein et al. (2025)"),
Beryciformes_mean = c(95, 122, 100, 125, 74),
Beryciformes_min  = c(93, 108, 98, 70, 66),
Beryciformes_max  = c(97, 135, 107, 130, 81),
Trachichthyiformes_mean = c(40, 135, 46, 110, 106),
Trachichthyiformes_min  = c(38, 123, 24, 91, 91),
Trachichthyiformes_max  = c(42, 145, 75, 132, 124)
)
# ---------------------------
# 2. Fossil Data Parsing
# ---------------------------
beryciform_fossil_raw <- "Miobarbourisia_aomori (8,12); Quaesitoberyx_minutus (94,100); Beryciformes_Melamphaidae_Scopelogadus_capistranensis (5,12); Beryciformes_Melamphaidae_Scopelogadus_sp.__ (13,15); Holocentridae_Holocentrites_ovalis (33,37); Holocentridae_Africentrum_melitense (16,17); Holocentridae_Eoholocentrum_macrocephalum (48,56); Holocentridae_Berybolcensis_leptacanthus (48,56); Holocentridae_Iridopristis_parrisi (62,66); Holocentridae_Tenuicentrum_pattersoni (48,56); Stichocentrus_liratus (94,100); Kansius_sternbergi (84,85); Holocentridae_Caproberyx_superbus (90,101); Trachichythyoides_ornatus (94,101); Inocentrus_vulgaris_dont_use_name (84,85); Parospinus_cupulus (90,101); Ctenocephalichthys_longispinus (90,101); Stichopteryx_lewisi (94,100); Plesioberyx_maximus (94,100); Judeoberyx_princeps (94,100); Lissoberyx_dayi (94,100); Acrogaster_heckeli (86,94); Hoplopteryx_lewesiensis (94,100); Hoplopteryx_simus (90,94); Hoplopteryx_dakotaensis (90,94); Hoplopteryx_gephyrognathus (90,100)"
trachichthyiform_fossil_raw <- "Tubantia_cataphractus (72,84); Hgulichthys_spinus (95,100); Trachichthyiformes_Pseudomonocentridae_Handuichthys_interopercularis (93,113); Trachichthyiformes_Pseudomonocentridae_Pseudomonocentris_microspinosus (93,113); Antarctiberyx_seymouri (66,72); Trachichthyiformes_Trachichthyidae_Trachichthyidarum_causae (83,86); Erugocentrus_illyricus (83,86); Adriacentrus_crnolataci (83,86); Alloberyx_syriacus (83,86); Trachichthyiformes_Diretmidae_Diretmus_primus (66,72); Trachichthyiformes_Argyroberycidae_Argyroberyx_dentatus (66,72)"
parse_fossils <- function(raw_text, order_name) {
list_items <- strsplit(raw_text, "; ")[[1]]
data.frame(
Name = gsub(" \\(.*", "", list_items),
Ages = gsub(".*\\((.*)\\)", "\\1", list_items),
Order = order_name
) %>%
separate(Ages, into = c("Min", "Max"), sep = ",") %>%
mutate(across(c(Min, Max), as.numeric), Mean = (Min + Max) / 2) %>%
arrange(desc(Mean))
}
beryc_df <- parse_fossils(beryciform_fossil_raw, "Beryciformes") %>%
mutate(y_idx = seq(11.5, 9, length.out = n()))
trach_df <- parse_fossils(trachichthyiform_fossil_raw, "Trachichthyiformes") %>%
mutate(y_idx = seq(8.5, 6.5, length.out = n()))
fossil_all <- bind_rows(beryc_df, trach_df)
# ---------------------------
# 3. Plot Prep
# ---------------------------
geo_periods <- data.frame(
Period = c("JUR.", "CRETACEOUS", "PAL.", "EOC.", "OLIG.", "MIO.", "P-H"),
Start  = c(150, 145, 66, 56, 33.9, 23, 5.3), End = c(145, 66, 56, 33.9, 23, 5.3, 0),
Fill   = c("#34B2C9", "#7FC31C", "#FE913F", "#FDA762", "#FDBA7D", "#FFFF00", "#FFFFB2")
)
div_long <- divergence_data %>%
pivot_longer(cols = contains("mean"), names_to = "Order", values_to = "Mean") %>%
mutate(
Min = ifelse(grepl("Bery", Order), Beryciformes_min, Trachichthyiformes_min),
Max = ifelse(grepl("Bery", Order), Beryciformes_max, Trachichthyiformes_max),
Order = ifelse(grepl("Bery", Order), "Beryciformes", "Trachichthyiformes"),
y_pos = as.numeric(factor(Study, levels = rev(divergence_data$Study))) +
ifelse(Order == "Beryciformes", 0.2, -0.2)
)
# ---------------------------
# 4. The "Sexier" Bimodal Plot
# ---------------------------
ggplot() +
# K-Pg Boundary
geom_vline(xintercept = 66, color = "grey92", linetype = "dashed", size = 0.5) +
# GEOLOGICAL SCALE (Bottom)
geom_rect(data = geo_periods, aes(xmin = Start, xmax = End, ymin = -0.2, ymax = 0.4),
fill = geo_periods$Fill, color = "white", size = 0.1) +
geom_text(data = geo_periods, aes(x = (Start + End) / 2, y = 0.1, label = Period),
size = 2.5, fontface = "bold") +
# FOSSIL SECTION
# Fossil Confidence Intervals (Colored by Order, low alpha)
geom_rect(data = fossil_all, aes(xmin = Min, xmax = Max, ymin = y_idx - 0.04, ymax = y_idx + 0.04, fill = Order),
alpha = 0.2) +
# Fossil Daggers (Matching colors)
geom_text(data = fossil_all, aes(x = Mean, y = y_idx, label = "†", color = Order),
size = 4.5, fontface = "bold") +
# STUDY SECTION
geom_rect(data = div_long, aes(xmin = Min, xmax = Max, ymin = y_pos - 0.18, ymax = y_pos + 0.18, fill = Order),
alpha = 0.75, color = "white", size = 0.3) +
geom_segment(data = div_long, aes(x = Mean, xend = Mean, y = y_pos - 0.18, yend = y_pos + 0.18),
color = "black", size = 1.1) +
# LABELS & STYLING
annotate("text", x = 153, y = 10.25, label = "BERYCIFORM FOSSILS", angle = 90, size = 2.5, fontface = "bold", color = "#00CED1") +
annotate("text", x = 153, y = 7.5, label = "TRACHICHTHYIFORM FOSSILS", angle = 90, size = 2.5, fontface = "bold", color = "#FF3030") +
scale_x_reverse(limits = c(155, 0), breaks = seq(0, 150, 25), expand = c(0,0)) +
scale_y_continuous(breaks = 1:5, labels = rev(divergence_data$Study), limits = c(-0.5, 12.5)) +
scale_fill_manual(values = c("Beryciformes" = "#00F5FF", "Trachichthyiformes" = "#FF3030")) +
scale_color_manual(values = c("Beryciformes" = "#00CED1", "Trachichthyiformes" = "#CD2626")) +
labs(x = "Millions of Years Ago (Ma)", y = NULL, fill = "Order", color = "Order") +
theme_minimal(base_size = 14) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.major.x = element_line(color = "grey97"),
axis.text.y = element_text(face = "bold", size = 10, color = "black"),
legend.position = "none" # Color-coded labels on axis make legend redundant
)
