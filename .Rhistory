install.packages(c("gtools", "paleobioDB", "tidyverse", "sf", "rnaturalearth"))
library(gtools)
library(paleobioDB)
library(tidyverse)
library(sf)
library(rnaturalearth)
############################################
# 1. Download Fish Occurrences
############################################
trachy <- pbdb_occurrences(
base_name = "Trachichthyiformes",
limit = "all",
show = c("coords", "ident", "time")
)
beryci <- pbdb_occurrences(
base_name = "Beryciformes",
limit = "all",
show = c("coords", "ident", "time")
)
trachy$group <- "Trachichthyiformes"
beryci$group <- "Beryciformes"
occ_all <- bind_rows(trachy, beryci)
############################################
# 2. Download Reef Collections
############################################
reefs <- pbdb_collections(
envtype = "reef",
limit = "all",
show = c("loc", "time", "env")
)
############################################
# 3. Calculate Midpoint Ages
############################################
# Convert abbreviated age columns to numeric
occ_all$eag <- as.numeric(occ_all$eag)
occ_all$lag <- as.numeric(occ_all$lag)
occ_all$mid_ma <- (occ_all$eag + occ_all$lag) / 2
reefs$eag <- as.numeric(reefs$eag)
reefs$lag <- as.numeric(reefs$lag)
reefs$mid_ma <- (reefs$eag + reefs$lag) / 2
############################################
# 4. Time Bins
############################################
occ_all$time_bin <- cut(
occ_all$mid_ma,
breaks = c(0, 23, 66, 145),
labels = c("Neogene", "Paleogene", "Cretaceous"),
include.lowest = TRUE
)
reefs$time_bin <- cut(
reefs$mid_ma,
breaks = c(0, 23, 66, 145),
labels = c("Neogene", "Paleogene", "Cretaceous"),
include.lowest = TRUE
)
############################################
# 5. Convert to sf
############################################
occ_sf <- occ_all %>%
filter(!is.na(lng), !is.na(lat), !is.na(time_bin)) %>%
st_as_sf(coords = c("lng", "lat"), crs = 4326)
reefs_sf <- reefs %>%
filter(!is.na(lng), !is.na(lat), !is.na(time_bin)) %>%
st_as_sf(coords = c("lng", "lat"), crs = 4326)
world <- ne_countries(scale = "medium", returnclass = "sf")
############################################
# 6. Plot
############################################
ggplot() +
geom_sf(data = world, fill = "gray95", color = "gray70") +
# Reef localities
geom_sf(data = reefs_sf,
color = "darkgreen",
size = 1.2,
alpha = 0.35) +
# Fish occurrences
geom_sf(data = occ_sf,
aes(color = group),
size = 2,
alpha = 0.75) +
scale_color_manual(values = c(
"Trachichthyiformes" = "#FA8072",
"Beryciformes" = "#00F0FF"
)) +
facet_wrap(~time_bin) +
labs(
title = "Fossil Reef–Fish Overlap Through Time",
subtitle = "Trachichthyiformes (salmon) | Beryciformes (cyan) | Reef localities (green)",
color = "Order"
) +
theme_classic(base_size = 14) +
theme(
legend.position = "top",
axis.text = element_blank(),
axis.ticks = element_blank()
)
install.packages(c("gtools", "paleobioDB", "tidyverse", "sf", "rnaturalearth"))
############################################
# Fossil Fish and Reef Regions – Single Map
############################################
install.packages(c("gtools", "paleobioDB", "tidyverse", "sf", "rnaturalearth"))
library(gtools)
library(paleobioDB)
library(tidyverse)
library(sf)
library(rnaturalearth)
############################################
# 1. Download Fish Occurrences
############################################
trachy <- pbdb_occurrences(
base_name = "Trachichthyiformes",
limit = "all",
show = c("coords", "ident", "time")
)
beryci <- pbdb_occurrences(
base_name = "Beryciformes",
limit = "all",
show = c("coords", "ident", "time")
)
trachy$group <- "Trachichthyiformes"
beryci$group <- "Beryciformes"
occ_all <- bind_rows(trachy, beryci)
############################################
# 2. Download Reef Collections
############################################
reefs <- pbdb_collections(
envtype = "reef",
limit = "all",
show = c("loc", "time", "env")
)
############################################
# 3. Calculate Midpoint Ages
############################################
# Convert abbreviated PBDB age columns to numeric
occ_all$eag <- as.numeric(occ_all$eag)
occ_all$lag <- as.numeric(occ_all$lag)
occ_all$mid_ma <- (occ_all$eag + occ_all$lag) / 2
reefs$eag <- as.numeric(reefs$eag)
reefs$lag <- as.numeric(reefs$lag)
reefs$mid_ma <- (reefs$eag + reefs$lag) / 2
############################################
# 4. Convert Fish and Reefs to sf
############################################
occ_sf <- occ_all %>%
filter(!is.na(lng), !is.na(lat)) %>%
st_as_sf(coords = c("lng", "lat"), crs = 4326)
reefs_sf <- reefs %>%
filter(!is.na(lng), !is.na(lat)) %>%
st_as_sf(coords = c("lng", "lat"), crs = 4326)
world <- ne_countries(scale = "medium", returnclass = "sf")
############################################
# 5. Convert Reef Points to Regions Using Grid
############################################
grid_res <- 1  # grid resolution in degrees
world_bbox <- st_as_sfc(st_bbox(world))
grid <- st_make_grid(world_bbox, cellsize = grid_res, what = "polygons")
grid_sf <- st_sf(geometry = grid)
reefs_sf$reef_flag <- 1
# Spatial join reefs → grid
grid_reef <- st_join(grid_sf, reefs_sf, left = TRUE)
# Any cell with reef points is marked as present
grid_reef <- grid_reef %>%
mutate(reef_present = ifelse(!is.na(reef_flag), 1, 0))
############################################
# 6. Plot Single Global Map
############################################
ggplot() +
# Reef regions
geom_sf(data = grid_reef %>% filter(reef_present == 1),
fill = "darkgreen", color = NA, alpha = 0.4) +
# World outline
geom_sf(data = world, fill = NA, color = "gray70") +
# Fish occurrences
geom_sf(data = occ_sf, aes(color = group),
size = 2, alpha = 0.75) +
scale_color_manual(values = c(
"Trachichthyiformes" = "#FA8072",  # Salmon pink
"Beryciformes" = "#00F0FF"         # TRON cyan
)) +
labs(
title = "Fossil Fish Occurrences and Reef Regions",
subtitle = "Trachichthyiformes (salmon) | Beryciformes (cyan) | Reef regions (green)",
color = "Order"
) +
theme_classic(base_size = 14) +
theme(
legend.position = "top",
axis.text = element_blank(),
axis.ticks = element_blank()
)
